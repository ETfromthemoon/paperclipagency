# ──────────────────────────────────────────────────────────────────────────
# Plantilla de entorno para desplegar Paperclip y las empresas de este repo.
# Copia a .env y rellena tus valores. NO commitees el .env (ver .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# ── Núcleo de Paperclip ──────────────────────────────────────────────────
# Deja DATABASE_URL VACÍO para usar el PostgreSQL embebido (PGlite) en local.
# Para producción, apunta a tu propio Postgres:
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
DATABASE_URL=
PORT=3100
# Secreto de sesión: genera uno largo y aleatorio (p.ej. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# URL pública (usada en despliegues con Docker / VPS).
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# ── Claves de modelos (adaptadores de agentes) ───────────────────────────
# Claude Code (adaptador claude_local). Requiere el CLI `claude` instalado.
ANTHROPIC_API_KEY=
# Opcional, si usas también el adaptador de Codex:
OPENAI_API_KEY=

# ── Integraciones de skills (no nativas de Paperclip) ────────────────────
# Rellena solo las que vayas a usar. Las invocan los skills en companies/*/skills.
# Canva (contenido visual):
CANVA_API_TOKEN=
# Google (Gmail + Drive). Usa una service account o token OAuth según tu skill:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Deploy de sitios web (Strimo):
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
